{
  "name": "eslint-plugin-prose-spellcheck",
  "version": "0.1.1",
  "description": "Offline Markdown prose spellchecking for native ESLint Markdown, powered by CSpell.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "eslint-prose-spellcheck": "./src/cli.js"
  },
  "files": [
    "assets/",
    "src/",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --all --include=\"src/**/*.js\" --include=\"scripts/check-workflow-names.js\" --reporter=text --reporter=lcov node --test",
    "lint": "eslint . && eslint --config eslint.config-code-blocks.js \"**/*.md\" && node scripts/check-workflow-names.js",
    "test:package": "node scripts/check-package.js"
  },
  "dependencies": {
    "@cspell/dict-en_us": "4.4.43",
    "cspell-dictionary": "10.4.1",
    "cspell-lib": "10.4.1",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-util-decode-string": "2.0.1"
  },
  "peerDependencies": {
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.14.0"
  },
  "devDependencies": {
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-software-terms": "5.4.9",
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "c8": "12.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-markdown-preferences": "0.43.0",
    "eslint-plugin-markdown-preferences-paragraph": "0.1.0",
    "eslint-plugin-yml": "3.10.0",
    "title-case": "4.3.2",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/eslint-plugin-prose-spellcheck.git"
  },
  "homepage": "https://github.com/dblock/eslint-plugin-prose-spellcheck#readme",
  "bugs": {
    "url": "https://github.com/dblock/eslint-plugin-prose-spellcheck/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "markdown",
    "prose",
    "spellcheck",
    "cspell"
  ],
  "license": "MIT",
  "author": "Daniel (dB.) Doubrovkine"
}
