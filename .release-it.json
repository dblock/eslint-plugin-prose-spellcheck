{
  "git": {
    "requireBranch": "master",
    "requireCleanWorkingDir": false,
    "requireCommits": false,
    "commitMessage": "Release ${version}\n\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>",
    "tagAnnotation": "Release ${version}",
    "tagName": "v${version}",
    "pushRepo": "origin",
    "pushArgs": ["--follow-tags", "--atomic"],
    "changelog": "node scripts/release.js notes"
  },
  "npm": {
    "publishPath": ".release/package.tgz",
    "publishArgs": ["--access", "public", "--registry", "https://registry.npmjs.org"],
    "skipChecks": true,
    "allowSameVersion": true
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "assets": [".release/*.tgz", ".release/*.sha512"]
  },
  "hooks": {
    "before:init": "node scripts/release.js check",
    "after:bump": "node scripts/release.js prepare ${version}",
    "before:npm:release": "node scripts/release.js ready ${version}",
    "before:github:release": "node scripts/release.js refs ${version}",
    "after:release": [
      "node scripts/release.js next ${version}",
      "node scripts/release.js verify ${version}"
    ]
  }
}
